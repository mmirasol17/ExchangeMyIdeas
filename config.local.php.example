<?php
/*
 * Copy this file to config.local.php and fill in your database credentials.
 * config.local.php is gitignored -- never commit real credentials.
 *
 * Only needed on hosts that don't let you set environment variables
 * (most free shared PHP hosts). Otherwise set DB_HOST / DB_NAME /
 * DB_USER / DB_PASS in the environment and delete config.local.php.
 */

putenv('DB_HOST=localhost');
putenv('DB_NAME=your_database_name');
putenv('DB_USER=your_database_user');
putenv('DB_PASS=your_database_password');
