<?php
/*
 * Copy this file to config.local.php and fill in your database credentials.
 * config.local.php is gitignored -- never commit real credentials.
 *
 * We set plain PHP variables (not putenv) because some shared hosts, such as
 * InfinityFree, disable putenv()/getenv() for user scripts.
 */

$dbHost = 'localhost';                 // e.g. sql123.infinityfree.com (NOT localhost on InfinityFree)
$dbName = 'your_database_name';
$dbUser = 'your_database_user';
$dbPass = 'your_database_password';
