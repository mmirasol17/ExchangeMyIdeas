<?php
/*
 * Copy this file to config.local.php and fill in your values.
 * config.local.php is gitignored -- never commit real credentials.
 *
 * It belongs in the project root (next to index.php), which is where the
 * provisioning workflow uploads it and where src/config.php looks for it.
 *
 * We set plain PHP variables (not putenv) because some shared hosts, such as
 * InfinityFree, disable putenv()/getenv() for user scripts.
 */

// ---------------------------------------------------------------------------
// Database
// ---------------------------------------------------------------------------
$dbHost = 'localhost';                 // e.g. sql123.infinityfree.com (NOT localhost on InfinityFree)
$dbName = 'your_database_name';
$dbUser = 'your_database_user';
$dbPass = 'your_database_password';

// ---------------------------------------------------------------------------
// Operator keys
// ---------------------------------------------------------------------------

// Protects migrate.php. Generate a long random string and keep it private.
// Leave empty to disable the migration runner entirely.
$migrateKey = 'your_random_migration_key';

// Protects moderate.php, the review queue for flagged content. If you leave
// this empty, moderate.php falls back to $migrateKey so an existing deployment
// keeps working; set a separate value if you would rather not reuse one key
// for two jobs.
$adminKey = '';

// ---------------------------------------------------------------------------
// Privacy
// ---------------------------------------------------------------------------

// Salt for the one-way IP hashes used for rate limiting. The site never stores
// a raw IP address. Changing this resets everyone's rate-limit counters, which
// is harmless. If left empty a value is derived from $dbName, but a random
// string here is better -- it makes the hashes impossible to reverse by
// guessing common addresses.
$ipSalt = '';

// ---------------------------------------------------------------------------
// Google AdSense
// ---------------------------------------------------------------------------
// Leave empty to show placeholder ad slots. After you are approved, set both
// to render real ads:
//   $adsenseClient = 'ca-pub-1234567890123456';  // your publisher ID
//   $adsenseSlot   = '1234567890';               // an ad unit slot id
//
// $adsenseClient also drives /ads.txt (generated by ads.php), so setting it
// correctly is what makes that file valid.
$adsenseClient = '';
$adsenseSlot   = '';
